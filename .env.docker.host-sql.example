# Copying is optional: Initialize-HostSql.ps1 creates the private file if absent.
# The setup script fills the first three values without printing them.
# Do not overwrite a private file or regenerate a provisioned SQL login's password.
HOST_SQL_PASSWORD=
JWT_SIGNING_KEY=
NEW_USER_PASSWORD=

# Fill locally AFTER database setup. Never paste these values into chat or Git.
# Use the full Gmail address and a Google App Password (2-Step Verification required).
# Remove display spaces from the App Password. Never use your normal Google password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
