# REFERENCE ONLY. ubuntu_practice.py init --apply generates private files ON UBUNTU.
# Never copy Windows credentials here; never commit the populated private file.
PRACTICE_TAG=
PRACTICE_SQL_PASSWORD=
PRACTICE_JWT_KEY=
PRACTICE_DEMO_PASSWORD=

# Initial mail is deliberately undeliverable (container loopback port 1).
# After basic verification use ubuntu_practice.py gmail --apply, then recreate api.
PRACTICE_SMTP_HOST=127.0.0.1
PRACTICE_SMTP_PORT=1
PRACTICE_SMTP_SSL=false
PRACTICE_SMTP_USERNAME=
PRACTICE_SMTP_PASSWORD=
PRACTICE_SMTP_FROM=purchasing@project1.invalid
