Content-Type: application/json
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

{
  "name": "Interview Approval Updated",
  "steps": [
    {
      "code": "DRAFT",
      "name": "Draft",
      "displayOrder": 1,
      "isInitial": true,
      "isTerminal": false,
      "actions": [
        {
          "code": "SUBMIT",
          "name": "Submit interview record",
          "toStepCode": "APPROVED",
          "requiresComment": false,
          "actioners": [
            {
              "actionerType": "Requester",
              "actionerKey": null
            }
          ]
        }
      ]
    },
    {
      "code": "APPROVED",
      "name": "Approved",
      "displayOrder": 2,
      "isInitial": false,
      "isTerminal": true,
      "actions": []
    }
  ]
}

