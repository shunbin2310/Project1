# Inventory balances include active products that have not received stock yet as quantity 0.
GET {{Project1.Api_HostAddress}}/api/inventory
Accept: application/json
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

###

GET {{Project1.Api_HostAddress}}/api/inventory?lowStock=true
Accept: application/json
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

###

GET {{Project1.Api_HostAddress}}/api/inventory?productCategoryId={{productCategoryId}}&search=monitor
Accept: application/json
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

###

GET {{Project1.Api_HostAddress}}/api/inventory/{{productId}}
Accept: application/json
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

###

# The transaction should reference the Posted GRN and show quantity before and after.
GET {{Project1.Api_HostAddress}}/api/inventory/{{productId}}/transactions?type=GoodsReceipt
Accept: application/json
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

###

# After the final post, the purchase order status should be Received.
GET {{Project1.Api_HostAddress}}/api/purchase-orders/{{createPurchaseOrder.response.body.$.id}}
Accept: application/json
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

###

# Delete only works while a goods receipt is still Draft.
# Run this instead of Post when testing draft deletion.
DELETE {{Project1.Api_HostAddress}}/api/goods-receipts/{{createGoodsReceiptOne.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

###

# Run this cancellation request instead of the Goods Receiving flow above.
POST {{Project1.Api_HostAddress}}/api/purchase-orders/{{createPurchaseOrder.response.body.$.id}}/cancel
Content-Type: application/json
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

{
  "reason": "Supplier can no longer meet the required delivery date."
}

###

# Delete only works while the purchase order is still Draft.
# Run this instead of Issue when testing draft deletion.
DELETE {{Project1.Api_HostAddress}}/api/purchase-orders/{{createPurchaseOrder.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

###
