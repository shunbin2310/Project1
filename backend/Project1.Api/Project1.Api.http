GET {{Project1.Api_HostAddress}}/api/workflow-templates
Accept: application/json
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

###

# @name createWorkflowTemplate
POST {{Project1.Api_HostAddress}}/api/workflow-templates
Content-Type: application/json
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

{
  "code": "INTERVIEW_APPROVAL",
  "name": "Interview Approval",
  "entityType": "InterviewRecord",
  "steps": [
    {
      "code": "DRAFT",
      "name": "Draft",
      "displayOrder": 1,
      "isInitial": true,
      "isTerminal": false,
      "actions": [
        {
          "code": "SUBMIT",
          "name": "Submit",
          "toStepCode": "APPROVED",
          "requiresComment": false,
          "actioners": [
            {
              "actionerType": "Requester",
              "actionerKey": null
            }
          ]
        }
      ]
    },
    {
      "code": "APPROVED",
      "name": "Approved",
      "displayOrder": 2,
      "isInitial": false,
      "isTerminal": true,
      "actions": []
    }
  ]
}

###

GET {{Project1.Api_HostAddress}}/api/workflow-templates/{{createWorkflowTemplate.response.body.$.id}}
Accept: application/json
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

###

PUT {{Project1.Api_HostAddress}}/api/workflow-templates/{{createWorkflowTemplate.response.body.$.id}}
Content-Type: application/json
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

{
  "name": "Interview Approval Updated",
  "steps": [
    {
      "code": "DRAFT",
      "name": "Draft",
      "displayOrder": 1,
      "isInitial": true,
      "isTerminal": false,
      "actions": [
        {
          "code": "SUBMIT",
          "name": "Submit interview record",
          "toStepCode": "APPROVED",
          "requiresComment": false,
          "actioners": [
            {
              "actionerType": "Requester",
              "actionerKey": null
            }
          ]
        }
      ]
    },
    {
      "code": "APPROVED",
      "name": "Approved",
      "displayOrder": 2,
      "isInitial": false,
      "isTerminal": true,
      "actions": []
    }
  ]
}

###

POST {{Project1.Api_HostAddress}}/api/workflow-templates/{{createWorkflowTemplate.response.body.$.id}}/publish
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

###

# @name createWorkflowVersion
POST {{Project1.Api_HostAddress}}/api/workflow-templates/{{createWorkflowTemplate.response.body.$.id}}/versions
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

###

DELETE {{Project1.Api_HostAddress}}/api/workflow-templates/{{createWorkflowVersion.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

