Accept: application/json

###

POST {{Project1.Api_HostAddress}}/api/departments
Content-Type: application/json

{
  "code": "IT",
  "name": "Information Technology",
  "description": "Manages technology and internal systems"
}

###

PUT {{Project1.Api_HostAddress}}/api/departments/{{departmentId}}
Content-Type: application/json

{
  "name": "Information Technology",
  "description": "Manages technology, infrastructure, and internal systems",
  "isActive": true
}

###

DELETE {{Project1.Api_HostAddress}}/api/departments/{{departmentId}}

